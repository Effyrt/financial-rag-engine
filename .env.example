cat > .env.example << 'ENDFILE'
# ============================================================================
# AURELIA Environment Configuration - ENTERPRISE TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# ============================================================================
# OpenAI Configuration - REQUIRED
# ============================================================================
OPENAI_API_KEY=sk-proj-your-actual-key-here
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# ============================================================================
# AWS Configuration - REQUIRED for Cloud Deployment
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=aurelia-data

# ============================================================================
# Vector Database - Pinecone (Production)
# ============================================================================
PINECONE_API_KEY=your-pinecone-key-optional
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=aurelia-financial
PINECONE_DIMENSION=3072
PINECONE_METRIC=cosine

# ============================================================================
# Vector Database - ChromaDB (Development/Default)
# ============================================================================
CHROMA_PERSIST_DIRECTORY=/app/data/chromadb
CHROMA_COLLECTION_NAME=financial_concepts
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ============================================================================
# PostgreSQL Database
# ============================================================================
DATABASE_URL=postgresql://aurelia_user:aurelia_password@postgres:5432/aurelia
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aurelia
DB_USER=aurelia_user
DB_PASSWORD=aurelia_password

# ============================================================================
# Redis Cache
# ============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ENABLE_REDIS_CACHE=true
CACHE_TTL=3600

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=300
API_RELOAD=false
ENABLE_CORS=true
ALLOWED_ORIGINS=*

# ============================================================================
# Frontend Configuration
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
API_BASE_URL=http://api:8000

# ============================================================================
# RAG Configuration
# ============================================================================
VECTOR_DB_TYPE=chromadb
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_LENGTH=8000
CONFIDENCE_THRESHOLD=0.7
ENABLE_WIKIPEDIA_FALLBACK=true

# Retrieval Strategy: semantic, keyword, hybrid, adaptive
RETRIEVAL_STRATEGY=hybrid
ENABLE_QUERY_EXPANSION=true
ENABLE_RERANKING=true

# ============================================================================
# Concept Generation
# ============================================================================
INSTRUCTOR_MODEL=gpt-4-turbo-preview
INSTRUCTOR_TEMPERATURE=0.3
MAX_GENERATION_RETRIES=3
ENABLE_GENERATION_CACHING=true

# ============================================================================
# Performance & Optimization
# ============================================================================
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_WORKERS=5
PDF_PARALLEL_PROCESSING=true
PDF_MAX_WORKERS=4
PDF_QUALITY_THRESHOLD=0.7

# ============================================================================
# Logging & Monitoring
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
ENABLE_DISTRIBUTED_TRACING=true

# Sentry (Error Tracking) - Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_OCR=true
EXTRACT_IMAGES=true
EXTRACT_TABLES=true
EXTRACT_FORMULAS=true
PRESERVE_CODE_BLOCKS=true
PRESERVE_READING_ORDER=true
RESPECT_SECTIONS=true

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
REQUESTS_PER_MINUTE=100
RATE_LIMIT_STRATEGY=sliding_window

# ============================================================================
# Circuit Breaker
# ============================================================================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60

# ============================================================================
# Development/Debug Settings
# ============================================================================
DEBUG=false
TESTING=false
ENVIRONMENT=production
ENABLE_PROFILING=false

# ============================================================================
# Airflow Configuration
# ============================================================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
ENDFILE