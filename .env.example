# AURELIA Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# OpenAI Configuration
# ============================================================================
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# ============================================================================
# Vector Database - Pinecone (Production)
# ============================================================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=aurelia-financial-concepts
PINECONE_DIMENSION=3072
PINECONE_METRIC=cosine

# ============================================================================
# Vector Database - ChromaDB (Development/Alternative)
# ============================================================================
CHROMA_PERSIST_DIRECTORY=./data/chromadb
CHROMA_COLLECTION_NAME=financial_concepts

# ============================================================================
# PostgreSQL Database
# ============================================================================
DATABASE_URL=postgresql://aurelia_user:aurelia_password@localhost:5432/aurelia
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aurelia
DB_USER=aurelia_user
DB_PASSWORD=aurelia_password

# ============================================================================
# Google Cloud Platform (for cloud deployment)
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_BUCKET_NAME=aurelia-artifacts
GCS_PDF_PATH=raw/fintbx.pdf
GCS_CHUNKS_PATH=processed/chunks
GCS_CONCEPTS_PATH=concepts

# ============================================================================
# Cloud Composer (Managed Airflow)
# ============================================================================
COMPOSER_ENVIRONMENT=aurelia-composer
COMPOSER_LOCATION=us-central1

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=4
API_TIMEOUT=300

# ============================================================================
# Frontend Configuration
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
API_BASE_URL=http://api:8000

# ============================================================================
# RAG Configuration
# ============================================================================
VECTOR_DB_TYPE=chromadb
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_LENGTH=8000
CONFIDENCE_THRESHOLD=0.7
FALLBACK_TO_WIKIPEDIA=true

# ============================================================================
# Concept Generation
# ============================================================================
INSTRUCTOR_MODEL=gpt-4-turbo-preview
INSTRUCTOR_TEMPERATURE=0.3
MAX_RETRIES=3

# ============================================================================
# Caching Configuration
# ============================================================================
ENABLE_REDIS_CACHE=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
MEMORY_CACHE_SIZE=1000

# ============================================================================
# Logging & Monitoring
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# ============================================================================
# Performance Tuning
# ============================================================================
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_WORKERS=5
PDF_PARALLEL_PROCESSING=true
PDF_MAX_WORKERS=4
PDF_QUALITY_THRESHOLD=0.7

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_OCR=true
EXTRACT_IMAGES=true
EXTRACT_TABLES=true
PRESERVE_CODE_BLOCKS=true
PRESERVE_FORMULAS=true
RESPECT_SECTIONS=true

# ============================================================================
# Development Settings
# ============================================================================
DEBUG=false
TESTING=false
ENVIRONMENT=production