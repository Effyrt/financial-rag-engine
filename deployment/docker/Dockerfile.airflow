cat > deployment/docker/Dockerfile.airflow << 'ENDFILE'
# ============================================================================
# AURELIA Airflow Dockerfile - ENTERPRISE VERSION
# Production-ready Airflow with all dependencies
# ============================================================================

FROM apache/airflow:2.7.3-python3.11

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    vim \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Copy requirements
COPY requirements.txt /tmp/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# Install Airflow providers
RUN pip install --no-cache-dir \
    apache-airflow-providers-amazon==8.12.0 \
    apache-airflow-providers-postgres==5.7.1 \
    apache-airflow-providers-http==4.6.0

# Copy DAGs and source code
COPY --chown=airflow:airflow airflow/dags /opt/airflow/dags
COPY --chown=airflow:airflow src /opt/airflow/dags/repo/src

# Set environment variables
ENV AIRFLOW__CORE__LOAD_EXAMPLES=False
ENV AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
ENV AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
ENV PYTHONPATH=/opt/airflow/dags/repo:$PYTHONPATH

# Create necessary directories
RUN mkdir -p /opt/airflow/logs /opt/airflow/plugins

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Default command
CMD ["airflow", "webserver"]
ENDFILE